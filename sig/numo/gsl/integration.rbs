module Numo
  module GSL
    module Integration
      VERSION: String
      GAUSS15: Integer
      GAUSS21: Integer
      GAUSS31: Integer
      GAUSS41: Integer
      GAUSS51: Integer
      GAUSS61: Integer
      COSINE: Integer
      SINE: Integer
      def self.qag: (
        Numeric a,
        Numeric b,
        ?epsabs: Numeric,
        ?epsrel: Numeric,
        ?limit: Integer,
        ?key: Integer
      ) { (Float) -> Numeric } -> [Float, Float]
      def self.qng: (
        Numeric a,
        Numeric b,
        ?epsabs: Numeric,
        ?epsrel: Numeric
      ) { (Float) -> Numeric } -> [Float, Float, Integer]
      def self.qags: (
        Numeric a,
        Numeric b,
        ?epsabs: Numeric,
        ?epsrel: Numeric,
        ?limit: Integer
      ) { (Float) -> Numeric } -> [Float, Float]
      def self.qagp: (
        Array[Numeric] points,
        ?epsabs: Numeric,
        ?epsrel: Numeric,
        ?limit: Integer
      ) { (Float) -> Numeric } -> [Float, Float]
      def self.qagi: (
        ?epsabs: Numeric,
        ?epsrel: Numeric,
        ?limit: Integer
      ) { (Float) -> Numeric } -> [Float, Float]
      def self.qagiu: (
        Numeric a,
        ?epsabs: Numeric,
        ?epsrel: Numeric,
        ?limit: Integer
      ) { (Float) -> Numeric } -> [Float, Float]
      def self.qagil: (
        Numeric b,
        ?epsabs: Numeric,
        ?epsrel: Numeric,
        ?limit: Integer
      ) { (Float) -> Numeric } -> [Float, Float]
      def self.qawc: (
        Numeric a,
        Numeric b,
        Numeric c,
        ?epsabs: Numeric,
        ?epsrel: Numeric,
        ?limit: Integer
      ) { (Float) -> Numeric } -> [Float, Float]
      def self.qaws: (
        Numeric a,
        Numeric b,
        Numeric alpha,
        Numeric beta,
        Integer mu,
        Integer nu,
        ?epsabs: Numeric,
        ?epsrel: Numeric,
        ?limit: Integer
      ) { (Float) -> Numeric } -> [Float, Float]
      def self.qawo: (
        Numeric a,
        Numeric b,
        Numeric omega,
        Integer sine,
        ?epsabs: Numeric,
        ?epsrel: Numeric,
        ?limit: Integer
      ) { (Float) -> Numeric } -> [Float, Float]
      def self.qawf: (
        Numeric a,
        Numeric omega,
        Integer sine,
        ?epsabs: Numeric,
        ?limit: Integer
      ) { (Float) -> Numeric } -> [Float, Float]
      def self.cquad: (
        Numeric a,
        Numeric b,
        ?epsabs: Numeric,
        ?epsrel: Numeric,
        ?limit: Integer
      ) { (Float) -> Numeric } -> [Float, Float, Integer]
      def self.romberg: (
        Numeric a,
        Numeric b,
        ?epsabs: Numeric,
        ?epsrel: Numeric,
        ?limit: Integer
      ) { (Float) -> Numeric } -> [Float, Integer]
      def self.glfixed: (
        Numeric a,
        Numeric b,
        ?order: Integer
      ) { (Float) -> Numeric } -> Float
      def self.fixed: (
        (:legendre | :chebyshev | :chebyshev2 | :gegenbauer | :jacobi | :laguerre | :hermite | :exponential) type,
        order: Integer,
        a: Numeric,
        b: Numeric,
        ?alpha: Numeric,
        ?beta: Numeric
      ) { (Float) -> Numeric } -> Float
    end
  end
end
